{
  "name": "fernly-shop-practicum",
  "version": "1.0.0",
  "description": "Fernly, a small houseplant shop for practicing component, UI, API, end-to-end and accessibility testing with AI agents.",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "start": "concurrently -k -n api,web -c green,cyan \"npm run start -w api\" \"npm run dev -w web\"",
    "start:api": "npm run start -w api",
    "start:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "smoke": "node scripts/smoke.mjs",
    "cy:component": "cypress run --component --project web --expose grepTags=-@known-bug",
    "cy:ui": "cypress run --e2e --project web --expose grepTags=-@known-bug",
    "cy:open": "cypress open --project web",
    "test:pw": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.13.10",
    "ajv": "^8.20.0",
    "concurrently": "^9.1.2",
    "dotenv": "^18.0.9",
    "typescript": "^5.8.2"
  }
}
